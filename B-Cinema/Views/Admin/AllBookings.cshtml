@model IEnumerable<BookingCinema.Models.Booking>

@{
    ViewData["Title"] = "All Bookings";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="text-primary mb-0">
                <i class="bi bi-calendar-check"></i> All Bookings
            </h2>
            <small class="text-muted">
                Total: @Model.Count() bookings
            </small>
        </div>
        
    </div>

    <div class="card shadow border-0">
        <div class="card-body p-0">
            <table class="table table-hover mb-0">
                <thead class="table-dark">
                    <tr>
                        <th class="ps-4">Booking ID</th>
                        <th>User</th>
                        <th>Movie</th>
                        <th>Date</th>
                        <th>Time</th>
                        <th>Seats</th>
                        <th>Total</th>
                        <th>Status</th>
                        <th class="text-center pe-4">Actions</th>
                    </tr>
                </thead>

                <tbody>
                    @if (Model.Any())
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="fw-bold ps-4">#@item.Id</td>
                                <td>@item.User?.Name</td>
                                <td>@item.Showtime?.Movie?.Title</td>
                                <td>@item.Showtime?.MovieDate.ToShortDateString()</td>
                                <td>@item.Showtime?.MovieTime.ToString(@"hh\:mm")</td>
                                <td>@item.Quantity</td>
                                <td>Rs. @item.TotalAmount</td>

                                <td>
                                    @if (item.Status == "Confirmed")
                                    {
                                        <span class="badge bg-success">Confirmed</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">Cancelled</span>
                                    }
                                </td>

                                <td class="text-center pe-4">
                                    <div class="btn-group">

                                        <a asp-action="Details" asp-route-id="@item.Id"
                                               class="btn btn-sm btn-outline-primary">
                                               Edit
                                            <i class="fas fa-eye"></i>
                                        </a>

                                        @if (item.Status == "Confirmed")
                                        {
                                            <a asp-action="Cancel" asp-route-id="@item.Id"
                                                   class="btn btn-sm btn-outline-danger"
                                                   onclick="return confirm('Cancel this booking?')">Delete
                                                <i class="fas fa-times"></i>
                                            </a>
                                        }

                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="9" class="text-center text-muted py-4">
                                No bookings found.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>